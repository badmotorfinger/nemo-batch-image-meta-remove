[Nemo Action]
Active=true
Name=Remove JPEG metadata
Name[ca]=Elimina metadades JPEG
Name[cs]=Odebrat metadata JPEG
Name[es]=Eliminar metadatos JPEG
Name[eu]=Kendu JPEG metadatuak
Name[fi]=Poista JPEG-metatiedot
Name[fr]=Supprimer les métadonnées JPEG
Name[hu]=JPEG metaadatok eltávolítása
Name[it]=Rimuovi metadati JPEG
Name[nl]=Verwijder JPEG-metadata
Name[pt]=Remover metadados JPEG
Name[uk]=Видалити метадані JPEG
Comment=Remove metadata from %F JPEG files
Comment[ca]=Elimina metadades dels fitxers JPEG %F
Comment[cs]=Odebrat metadata ze souborů JPEG %F
Comment[es]=Eliminar metadatos de los archivos JPEG %F
Comment[eu]=Kendu metadatuak %F JPEG fitxategietatik
Comment[fi]=Poista metatiedot %F JPEG-tiedostoista
Comment[fr]=Supprimer les métadonnées des fichiers JPEG %F
Comment[hu]=Metaadatok eltávolítása a(z) %F JPEG fájlokból
Comment[it]=Rimuovi metadati dai file JPEG %F
Comment[nl]=Verwijder metadata van %F JPEG-bestanden
Comment[pt]=Remover metadados dos arquivos JPEG %F
